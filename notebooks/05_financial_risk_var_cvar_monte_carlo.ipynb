  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import numpy as np,pandas as pd,matplotlib.pyplot as plt\n","rng=np.random.default_rng(42); r=pd.Series(rng.normal(.007,.045,120))\n","q=np.quantile(r,.05); VaR95=-q; CVaR95=-r[r<=q].mean(); Sharpe=(r.mean()/r.std())*np.sqrt(12)\n","print({'VaR_95':VaR95,'CVaR_95':CVaR95,'Annualized_Sharpe':Sharpe})\n","sim=rng.normal(r.mean(),r.std(),10000); plt.hist(sim,bins=50);plt.axvline(-VaR95);plt.title('Simulated Returns')"]},
  {"cell_type":"markdown","metadata":{},"source":["VaR gives a percentile loss threshold; CVaR summarizes the average loss beyond that threshold. Results depend on distributional assumptions and should be stress-tested."]}
