  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["sql = '''\nSELECT Region, SUM(Net_Revenue) AS net_revenue, SUM(Profit) AS profit, SUM(Profit)/SUM(Net_Revenue) AS margin\nFROM retailmart GROUP BY Region ORDER BY net_revenue DESC;\n\nSELECT strftime('%Y-%m', Order_Date) AS month, SUM(Net_Revenue) AS net_revenue\nFROM retailmart GROUP BY month ORDER BY month;\n\nSELECT Product, SUM(Net_Revenue) AS net_revenue FROM retailmart GROUP BY Product ORDER BY net_revenue DESC LIMIT 10;\n'''\nprint(sql)"]},
